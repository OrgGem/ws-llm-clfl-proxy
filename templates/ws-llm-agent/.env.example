# Copy to .env, fill in values from your Identity administrator, then chmod 600 .env.
# This file is parsed by ws-llm-adapter. It is data, not a shell script.
WS_PROXY_CONFIG_SOURCE=env
WS_PROXY_IDENTITY_URL=https://identity.example.invalid
WS_PROXY_GATEWAY_URL=wss://gateway.example.invalid/v1/socket
WS_PROXY_CLIENT_ID=replace-with-confidential-client-id
WS_PROXY_CLIENT_SECRET=replace-with-confidential-client-secret
WS_PROXY_LOCAL_BEARER_TOKEN=replace-with-local-adapter-bearer
WS_PROXY_ENVELOPE_FILE=./credentials/credential-envelope.json
WS_PROXY_MODEL_ALIAS=replace-with-project-authorized-model-alias
WS_PROXY_PROVIDER=openai
WS_PROXY_PROTOCOL=openai
